# Copy this file to .env for local development.

# Admin login for /admin.html
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string, 32+ characters. Used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Local development database (a single file). Ignored by git.
DATABASE_URL=file:./data/portfolio.db

# Production database (Turso). Leave empty for local file storage.
# This project's database: libsql://oumar-jason989.aws-ap-south-1.turso.io
# Requires a token: turso db tokens create oumar-jason989
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional salt for hashing visitor IPs in rate limiting.
IP_SALT=
